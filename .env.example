# Use deterministic local data until both provider credentials are available.
MOVIE_NIGHT_DEMO_MODE=true

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=replace-with-an-openai-platform-api-key
OPENAI_MODEL=gpt-5.6-luna
TMDB_API_TOKEN=replace-with-a-tmdb-v4-read-access-token

# ISO 3166-1 country code used for certification and availability.
MOVIE_NIGHT_REGION=GB
